# NeuroScript AI Configuration Template
# Copy this file to .env or configure environment variables in your deployment host.
# WARNING: Never commit real keys or production secrets to source control.

# ASP.NET Core Hosting Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# Proxy Security & Client Authentication
# Value required in the X-Api-Key header by clients calling the backend proxy
PROXY_API_KEY=neuroscript-dev-internal-key-3b9e8a

# Upstream Google Gemini LLM Credentials (Milestone 4A)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Generator Mode (Mock for development/testing, Gemini for live LLM compiler)
GENERATOR_MODE=Mock

# Rate Limiting Configuration (Per Install ID)
RATE_LIMIT_PER_MINUTE=10
