{
  "version": "1.0.0",
  "weights": {
    "semantic": 0.6,
    "lexical": 0.4
  },
  "thresholds": {
    "accept": 0.75,
    "regenerate": 0.50,
    "discard": 0.00
  },
  "entityCheck": {
    "enforceExactMatch": true,
    "supportedEntityTypes": [
